# NEO4J_PASSWORD cannot contain "/" (Neo4j reads NEO4J_AUTH as user/password).
NEO4J_PASSWORD=
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
KT_TOKEN=
KT_BONFIRE_ID=hermes
MK_VERSION=2.0.1

# Optional. The values shown are the defaults.
# The most the writer may spend on building memory, in USD. Read only when the first session founds the memory.
# KT_SPEND_CEILING_USD=20
# The most the first session may spend, in USD.
# KT_FOUNDING_CAP_USD=1
# How many times the writer tries a session before it marks it failed.
# KT_WRITER_MAX_TRIES=3
